import { CircleIcon } from "@ui/widgets.slint";
import { CardColor, IconSize } from "@ui/theme.slint";
//
// Clean Decred account card (app-scoped). Flat dark surface, clear hierarchy:
// brand label, bold account name, large balance (companion-relayed once
// QuantumLink lands; mock until then), muted USD subtitle, crisp logo badge.
// Tapping the card opens the accounts page.
export component DcrAccountCard inherits Rectangle {
    in property <string> name: "Decred";
    in property <string> crypto-balance;
    in property <string> fiat-balance;
    // Small "* via SD card" source tag, and optional freshness.
    in property <string> source-note;
    in property <string> as-of;

    callback clicked();

    TouchArea {
        clicked => {
            root.clicked();
        }
    }

    height: 168px;
    border-radius: 20px;
    clip: true;
    background: #0e0e12;
    border-width: 1px;
    border-color: #20232e;

    HorizontalLayout {
        padding-left: 28px;
        padding-right: 24px;
        spacing: 16px;

        // Left: brand + balance + fiat, clear vertical hierarchy.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 6px;

            Text {
                text: "DECRED";
                color: #2970ff;
                font-size: 13px;
                font-weight: 700;
                letter-spacing: 2px;
            }
            Text {
                text: name;
                color: #ffffff;
                font-size: 24px;
                font-weight: 800;
            }
            Text {
                text: crypto-balance;
                color: #ffffff;
                font-size: 38px;
                font-weight: 800;
            }
            Text {
                text: fiat-balance;
                color: #9aa0ab;
                font-size: 18px;
                font-weight: 600;
            }
            if source-note != "": Text {
                text: source-note;
                color: #6b7280;
                font-size: 11px;
            }
            if as-of != "": Text {
                text: as-of;
                color: #6b7280;
                font-size: 11px;
            }
        }

        // Right: a simple, clean logo badge.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            CircleIcon {
                icon: "decred";
                line-color: CardColor.decred;
                size: 96px;
                icon-size: IconSize.px96;
            }
        }
    }
}
