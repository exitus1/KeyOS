//
// Clean Decred account card (app-scoped). Flat dark surface, clear hierarchy:
// small brand label, large balance, muted USD subtitle, simple logo badge.
export component DcrAccountCard inherits Rectangle {
    in property <string> name: "Decred";
    in property <string> crypto-balance;
    in property <string> fiat-balance;

    height: 150px;
    border-radius: 20px;
    clip: true;
    background: #0e0e12;
    border-width: 1px;
    border-color: #20232e;

    HorizontalLayout {
        padding-left: 28px;
        padding-right: 24px;
        spacing: 16px;

        // Left: brand + balance + fiat, clear vertical hierarchy.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 6px;

            Text {
                text: "DECRED";
                color: #2970ff;
                font-size: 14px;
                font-weight: 700;
                letter-spacing: 2px;
            }
            Text {
                text: crypto-balance;
                color: #ffffff;
                font-size: 46px;
                font-weight: 800;
            }
            Text {
                text: fiat-balance;
                color: #9aa0ab;
                font-size: 22px;
                font-weight: 600;
            }
        }

        // Right: a simple, clean logo badge.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Rectangle {
                width: 96px;
                height: 96px;
                border-radius: 24px;
                background: #2970ff;
                border-width: 1px;
                border-color: #2970ff;
                Image {
                    width: 64px;
                    height: 64px;
                    source: @image-url("@ui/icons/decred-logo.svg");
                    colorize: #ffffff;
                }
            }
        }
    }
}
