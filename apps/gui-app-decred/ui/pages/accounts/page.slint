//
// Accounts: list the named BIP44 accounts (m/44'/42'/N'), switch the active
// one by tapping, and create new named accounts. Seed/wallet creation lives
// in the OS Seed Vault — this page only manages sub-accounts of the active
// seed. Account metadata is names + indices only; nothing sensitive.

import { BasePage, NavHeader, PageBody, ContentSection, ButtonSection, Button } from "@ui/widgets.slint";
import { Palette, Size, Importance } from "@ui/theme.slint";
import { Navigate } from "../../gen/navigate.slint";
import { Account, AccountRow } from "../../account.slint";
import { Passphrase } from "../../passphrase.slint";

export component AccountsPage inherits BasePage {
    // Whether the inline "name a new account" editor is open.
    property <bool> creating: false;
    property <string> new-name: "";

    NavHeader {
        clicked => {
            Navigate.backward();
        }
    }

    PageBody {
        ContentSection {
            spacing: Size.sz3;

            Text {
                text: "Accounts";
                color: #ffffff;
                font-size: 27px;
                font-weight: 800;
                horizontal-alignment: center;
            }
            Text {
                text: Passphrase.active
                    ? "Accounts of hidden wallet " + Passphrase.code
                    : "Separate balances under this wallet";
                color: Passphrase.active ? #ffb45e : #9aa0ab;
                font-size: 15px;
                horizontal-alignment: center;
            }
            if Passphrase.active: Text {
                text: "Hidden wallet accounts are not saved. Next time you open this wallet only Main will be listed - recreate accounts in the same order to reach the same coins.";
                color: #9aa0ab;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle { height: 6px; }

            for row in Account.rows: Rectangle {
                height: 92px;
                border-radius: 20px;
                background: row.active
                    ? @linear-gradient(135deg, #16255280 0%, #0b122650 100%)
                    : #0c0c10;
                border-width: row.active ? 2px : 1px;
                border-color: row.active ? #2970ff : #1c1c1c;
                clip: true;

                // Accent edge: a slim colored bar keyed to the account.
                Rectangle {
                    x: 0;
                    width: 5px;
                    height: parent.height;
                    background: row.accent;
                }

                TouchArea {
                    clicked => {
                        Account.set-active-account(row.idx);
                    }
                }

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 18px;
                    spacing: 16px;

                    // Avatar: accent circle with the account's initial.
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 24px;
                            background: row.accent.with-alpha(0.18);
                            border-width: 1.5px;
                            border-color: row.accent;
                            Text {
                                text: row.initial;
                                color: row.accent;
                                font-size: 22px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        horizontal-stretch: 1;
                        Text {
                            text: row.name;
                            color: #ffffff;
                            font-size: 22px;
                            font-weight: 800;
                        }
                        Text {
                            text: row.path;
                            color: #9aa0ab;
                            font-size: 14px;
                        }
                    }

                    // Right: bold filled ACTIVE pill, or a quiet chevron.
                    if row.active: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 76px;
                            height: 30px;
                            border-radius: 15px;
                            background: #2970ff;
                            Text {
                                text: "ACTIVE";
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 800;
                                letter-spacing: 1.5px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if !row.active: VerticalLayout {
                        alignment: center;
                        Text {
                            text: "›";
                            color: #3a3a44;
                            font-size: 26px;
                            font-weight: 700;
                        }
                    }
                }
            }

            // --- inline create editor ---
            if creating: Rectangle {
                height: 60px;
                border-radius: 16px;
                background: #08080a;
                border-width: 1px;
                border-color: #2970ff;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    TextInput {
                        vertical-alignment: center;
                        color: #ffffff;
                        font-size: 20px;
                        text: root.new-name;
                        edited => {
                            root.new-name = self.text;
                        }
                        accepted => {
                            root.new-name = self.text;
                            Account.create-account(self.text);
                            if (Account.name-error == "") {
                                creating = false;
                                root.new-name = "";
                            }
                        }
                    }
                }
            }
            if creating && root.new-name == "": Text {
                text: "Type a name for the new account";
                color: #9aa0ab;
                font-size: 14px;
                horizontal-alignment: center;
            }
            if creating && Account.name-error != "": Text {
                text: Account.name-error;
                color: #ff6b6b;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        ButtonSection {
            if !creating && Passphrase.active: Button {
                label: "Back to normal accounts";
                importance: Importance.secondary;
                clicked => {
                    Passphrase.clear();
                }
            }
            if !creating: Button {
                label: "Passphrase wallet…";
                importance: Importance.secondary;
                clicked => {
                    Navigate.passphrase({ });
                }
            }
            if !creating: Button {
                label: "New account";
                importance: Importance.primary;
                background: #2970ff;
                clicked => {
                    Account.name-error = "";
                    root.new-name = "";
                    creating = true;
                }
            }
            if creating: Button {
                label: "Create";
                importance: Importance.primary;
                background: #2970ff;
                clicked => {
                    Account.create-account(root.new-name);
                    if (Account.name-error == "") {
                        creating = false;
                        root.new-name = "";
                    }
                }
            }
            if creating: Button {
                label: "Cancel";
                importance: Importance.secondary;
                clicked => {
                    creating = false;
                }
            }
        }
    }
}
