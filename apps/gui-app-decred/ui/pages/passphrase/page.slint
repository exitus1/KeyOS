// SPDX-License-Identifier: GPL-3.0-or-later
//
// Passphrase flow, ported step-by-step from gui-app-bitcoin's enter-passphrase
// (warning modal -> enter -> confirm-with-fingerprint), with Foundation's own
// copy ("Bitcoin" -> "Decred") plus one added sentence making the seed-backup
// limitation explicit.

import { BasePage, NavHeader, PageBody, ContentSection, ButtonSection, Button } from "@ui/widgets.slint";
import { Palette, Size, Importance } from "@ui/theme.slint";
import { Navigate } from "../../gen/navigate.slint";
import { Passphrase } from "../../passphrase.slint";

export component PassphrasePage inherits BasePage {
    // 0 = warning modal, 1 = enter, 2 = confirm
    property <int> stage: 0;
    property <string> entry: "";

    NavHeader {
        clicked => {
            if (stage == 2) {
                stage = 1;
            } else if (stage == 1) {
                stage = 0;
            } else {
                Navigate.backward();
            }
        }
    }

    PageBody {
        ContentSection {
            spacing: Size.sz3;

            // ---- Stage 0: warning (Bitcoin app's "Using a Passphrase" modal) ----
            if stage == 0: Text {
                text: "Using a Passphrase";
                color: #ffffff;
                font-size: 27px;
                font-weight: 800;
                horizontal-alignment: center;
            }
            if stage == 0: Rectangle { height: 8px; }
            if stage == 0: Text {
                text: "A passphrase acts as a second layer of security to protect your Decred.";
                color: #c9cdd6;
                font-size: 16px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if stage == 0: Text {
                text: "To access Decred protected by a passphrase, you must reenter the exact same characters.";
                color: #c9cdd6;
                font-size: 16px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if stage == 0: Rectangle {
                border-radius: 16px;
                background: #2a1c0e;
                border-width: 1px;
                border-color: #ff9f2d;
                VerticalLayout {
                    padding: 14px;
                    Text {
                        text: "It is crucial to back up your passphrase. Your seed backup ALONE cannot recover this wallet — restoring it needs your seed AND the exact passphrase.";
                        color: #ffd9ad;
                        font-size: 15px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            // ---- Stage 1: enter ------------------------------------------------
            if stage == 1: Text {
                text: "Enter Passphrase";
                color: #ffffff;
                font-size: 27px;
                font-weight: 800;
                horizontal-alignment: center;
            }
            if stage == 1: Text {
                text: "Type with care. All passphrases are valid. Ensure you back up your passphrase.";
                color: #9aa0ab;
                font-size: 15px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if stage == 1: Rectangle {
                height: 64px;
                border-radius: 16px;
                background: #08080a;
                border-width: 1px;
                border-color: #2970ff;
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    TextInput {
                        vertical-alignment: center;
                        color: #ffffff;
                        font-size: 20px;
                        text: root.entry;
                        edited => {
                            root.entry = self.text;
                        }
                        accepted => {
                            root.entry = self.text;
                            Passphrase.preview(self.text);
                            if (Passphrase.error == "") {
                                stage = 2;
                            }
                        }
                    }
                }
            }
            if stage == 1 && root.entry == "": Text {
                text: "Enter passphrase...";
                color: #9aa0ab;
                font-size: 14px;
                horizontal-alignment: center;
            }

            // ---- Stage 2: confirm (passphrase + fingerprint, like Bitcoin) -----
            if stage == 2: Text {
                text: "Confirm Passphrase";
                color: #ffffff;
                font-size: 27px;
                font-weight: 800;
                horizontal-alignment: center;
            }
            if stage == 2: Rectangle {
                height: 128px;
                border-radius: 16px;
                background: #08080a;
                border-width: 1px;
                border-color: #1c1c1c;
                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    Text {
                        text: "PASSPHRASE";
                        color: #2970ff;
                        font-size: 12px;
                        font-weight: 800;
                        letter-spacing: 1.5px;
                    }
                    Text {
                        text: root.entry;
                        color: #ffffff;
                        font-size: 21px;
                        font-weight: 700;
                        wrap: char-wrap;
                    }
                    Rectangle { height: 4px; }
                    Text {
                        text: "FINGERPRINT";
                        color: #2970ff;
                        font-size: 12px;
                        font-weight: 800;
                        letter-spacing: 1.5px;
                    }
                    Text {
                        text: Passphrase.code;
                        color: #2dd8a3;
                        font-size: 21px;
                        font-weight: 800;
                    }
                }
            }
            if stage == 2: Text {
                text: "Your passphrase will be erased upon shutdown, or can be manually cleared by returning to this screen.";
                color: #9aa0ab;
                font-size: 15px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if Passphrase.error != "": Text {
                text: Passphrase.error;
                color: #ff6b6b;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        ButtonSection {
            if stage == 0: Button {
                label: "Continue";
                importance: Importance.primary;
                background: #2970ff;
                clicked => {
                    stage = 1;
                }
            }
            if stage == 1: Button {
                label: "Apply Passphrase";
                importance: Importance.primary;
                background: #2970ff;
                clicked => {
                    Passphrase.preview(root.entry);
                    if (Passphrase.error == "") {
                        stage = 2;
                    }
                }
            }
            if stage == 2: Button {
                label: "Confirm";
                importance: Importance.primary;
                background: #2970ff;
                clicked => {
                    Passphrase.apply(root.entry);
                    if (Passphrase.error == "") {
                        Navigate.home({ });
                    }
                }
            }
            if stage == 2: Button {
                label: "Back";
                importance: Importance.secondary;
                clicked => {
                    stage = 1;
                }
            }
            if Passphrase.active: Button {
                label: "Clear Passphrase";
                importance: Importance.secondary;
                clicked => {
                    Passphrase.clear();
                    root.entry = "";
                    stage = 0;
                }
            }
        }
    }
}
