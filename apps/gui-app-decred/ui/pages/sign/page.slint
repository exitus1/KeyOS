// SPDX-License-Identifier: GPL-3.0-or-later
//
// Sign: the core flow. One page, driven by SignTx.state.
//   Idle     -> choose QR or SD as the source of the unsigned package
//   Scanning -> animated-QR capture in progress
//   Review   -> recipients / amount / fee, then Approve (fires the seed gate)
//   ShowQr   -> signed tx as animated QR to scan back into the companion
//   Done     -> signed tx written to SD card
//   Error    -> refused or failed

import { BasePage, NavHeader, PageBody, ContentSection, ButtonSection, Button, DynamicQrCode, HeadingSm, HeadingMd, TextMd, TextSm, HLine, TimerCircularProgress, Icon } from "@ui/widgets.slint";
import { Palette, Size, Importance, IconSize } from "@ui/theme.slint";
import { TR2, TrId } from "../../gen/tr.slint";
import { Navigate } from "../../gen/navigate.slint";
import { SignTx, SignState, RecipientView } from "../../sign-tx.slint";
import { Passphrase } from "../../passphrase.slint";

export component SignPage inherits BasePage {
    init => {
        // Always start the signing flow clean (don't reopen on a stale QR/Done).
        SignTx.reject();
    }
    NavHeader {
        clicked => {
            Navigate.backward();
        }
    }

    PageBody {
        ContentSection {
            spacing: Size.sz4;

            // --- Idle: pick a transport -------------------------------------
            if SignTx.state == SignState.Picking: Flickable {
                VerticalLayout {
                spacing: Size.sz3;
                Text {
                    text: "Choose a transaction";
                    color: #ffffff;
                    font-size: 26px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Files found on the card, newest first.";
                    color: #9aa0ab;
                    font-size: 15px;
                    horizontal-alignment: center;
                    TouchArea {
                        clicked => {
                            SignTx.debug-cycle();
                        }
                    }
                }
                Rectangle { height: 4px; }
                for f in SignTx.sd-files: Rectangle {
                    height: 68px;
                    border-radius: 16px;
                    background: #0c0c10;
                    border-width: 1px;
                    border-color: #1f2233;
                    TouchArea {
                        clicked => {
                            SignTx.pick-file(f.name);
                        }
                    }
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: f.name;
                                color: #ffffff;
                                font-size: 18px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: f.detail;
                                color: #9aa0ab;
                                font-size: 13px;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "›";
                                color: #3a3a44;
                                font-size: 26px;
                                font-weight: 700;
                            }
                        }
                    }
                }
            }
            }

            if SignTx.state == SignState.Idle: VerticalLayout {
                spacing: Size.sz4;
                HeadingSm {
                    text: TR2.lookup(TrId.SignChooseSource);
                    horizontal-alignment: center;
                }

                TextSm {
                    text: TR2.lookup(TrId.SignChooseSourceHint);
                    color: Palette.content-tertiary;
                    horizontal-alignment: center;
                }
            }

            // --- Scanning ----------------------------------------------------
            if SignTx.state == SignState.Scanning: VerticalLayout {
                spacing: Size.sz4;
                HorizontalLayout {
                    alignment: center;
                    TimerCircularProgress {
                        indeterminate: true;
                    }
                }

                TextMd {
                    text: TR2.lookup(TrId.SignScanning);
                    horizontal-alignment: center;
                }
            }

            // --- Review (ported from decred_review.slint mockup) -------------
            // Flickable: multi-recipient reviews can exceed the screen; the
            // content scrolls while Approve/Reject stay pinned below.
            if SignTx.state == SignState.Review: Flickable {
                VerticalLayout {
                spacing: 0px;

                Text {
                    text: "Review transaction";
                    color: #ffffff;
                    font-size: 26px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }
                // Account woven into the header, main-screen style.
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: "spending from";
                        color: #9aa0ab;
                        font-size: 16px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: SignTx.signing-account;
                        color: #7ea6ff;
                        font-size: 18px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                }
                if Passphrase.active: Rectangle { height: 6px; }
                if Passphrase.active: Rectangle {
                    height: 26px;
                    border-radius: 13px;
                    background: #2a1c0e;
                    border-width: 1px;
                    border-color: #ff9f2d;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "HIDDEN WALLET · " + Passphrase.code;
                            color: #ffb45e;
                            font-size: 11px;
                            font-weight: 800;
                            letter-spacing: 1.5px;
                            horizontal-alignment: center;
                        }
                    }
                }

                Rectangle { height: 12px; }
                // HARD WARNING: companion mislabelled non-owned outputs as change.
                if SignTx.flagged-count > 0: Rectangle {
                    height: 92px;
                    border-radius: 16px;
                    background: #2a0e0e;
                    border-width: 1.5px;
                    border-color: #ff4d4d;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        Text {
                            text: "⚠ SECURITY WARNING";
                            color: #ff6b6b;
                            font-size: 14px;
                            font-weight: 800;
                            letter-spacing: 1px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Your companion labelled an output as change that is NOT one of your addresses. A correct wallet never does this — it may be faulty or hostile. Verify the recipients below.";
                            color: #ffb3b3;
                            font-size: 12px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
                if SignTx.flagged-count > 0: Rectangle { height: 12px; }
                // ORANGE ALARM: fee is technically valid but suspiciously large.
                if SignTx.fee-warning: Rectangle {
                    height: 84px;
                    border-radius: 16px;
                    background: #2a1c0e;
                    border-width: 1.5px;
                    border-color: #ff9f2d;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        Text {
                            text: "⚠ UNUSUALLY HIGH FEE";
                            color: #ffb45e;
                            font-size: 14px;
                            font-weight: 800;
                            letter-spacing: 1px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "This transaction pays a very large network fee. That money goes to miners and cannot be recovered. Check the fee below.";
                            color: #ffd9ad;
                            font-size: 12px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
                if SignTx.fee-warning: Rectangle { height: 12px; }

                // Amount hero
                Rectangle {
                    height: 130px;
                    background: #08080a;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: #1c1c1c;
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: "SENDING";
                            color: #2970ff;
                            font-size: 14px;
                            font-weight: 600;
                            letter-spacing: 2px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: SignTx.send-total;
                            color: #ffffff;
                            font-size: 42px;
                            font-weight: 800;
                            horizontal-alignment: center;
                        }
                    }
                }

                Rectangle { height: 14px; }

                // Detail card
                Rectangle {
                    background: #08080a;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: #1c1c1c;
                    VerticalLayout {
                        padding: 8px;
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 0px;

                        // RECIPIENTS — device-decoded destinations in the same
                        // verification grid as the Receive screen: 5-char
                        // groups, outer groups emphasized.
                        for r[i] in SignTx.recipients: VerticalLayout {
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 4px;
                            if i == 0: Text {
                                text: SignTx.recipient-count > 1 ? "SENDING TO (MULTIPLE)" : "SENDING TO";
                                color: #2970ff;
                                font-size: 14px;
                                font-weight: 700;
                                letter-spacing: 1.5px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: r.top-first;
                                    color: #2dd8a3;
                                    font-size: 23px;
                                    font-weight: 800;
                                }
                                Text {
                                    text: r.top-rest;
                                    color: #ffffff;
                                    font-size: 23px;
                                    font-weight: 500;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: r.bottom-rest;
                                    color: #ffffff;
                                    font-size: 23px;
                                    font-weight: 500;
                                }
                                Text {
                                    text: r.bottom-last;
                                    color: #2dd8a3;
                                    font-size: 23px;
                                    font-weight: 800;
                                }
                            }
                            Rectangle { height: 4px; }
                            HorizontalLayout {
                                Text {
                                    text: "Amount";
                                    color: #9aa0ab;
                                    font-size: 18px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: r.amount;
                                    color: #ffffff;
                                    font-size: 20px;
                                    font-weight: 800;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                        Rectangle { height: 1px; background: #161616; }
                        HorizontalLayout {
                            height: 44px;
                            Text {
                                text: "Network fee";
                                color: #9aa0ab;
                                font-size: 18px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: SignTx.fee;
                                color: SignTx.fee-warning ? #ff9f2d : #ffffff;
                                font-size: 19px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                        }
                        HorizontalLayout {
                            Text {
                                text: "";
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: SignTx.fee-rate;
                                color: #9aa0ab;
                                font-size: 13px;
                                horizontal-alignment: right;
                            }
                        }
                        Rectangle { height: 1px; background: #161616; }
                        HorizontalLayout {
                            height: 44px;
                            Text {
                                text: "Change";
                                color: #9aa0ab;
                                font-size: 18px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: SignTx.change;
                                color: #ffffff;
                                font-size: 19px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                        }
                        HorizontalLayout {
                            Text {
                                text: "";
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "verified to your own keys";
                                color: #2dd8a3;
                                font-size: 14px;
                                font-weight: 600;
                                horizontal-alignment: right;
                            }
                        }
                    }
                }
            }

            }

            // --- ShowQr: signed, animated QR back ----------------------------
            if SignTx.state == SignState.ShowQr: VerticalLayout {
                spacing: Size.sz4;
                HeadingSm {
                    text: TR2.lookup(TrId.SignSignedTitle);
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    DynamicQrCode {
                        get-parts(density) => {
                            SignTx.signed-qr-parts();
                        }
                    }
                }

                TextSm {
                    text: TR2.lookup(TrId.SignSignedQrHint);
                    color: Palette.content-tertiary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // --- Done: written to SD ----------------------------------------
            if SignTx.state == SignState.Done: VerticalLayout {
                spacing: Size.sz4;

                Rectangle { height: 24px; }

                // Success mark: teal ring + check, verification-green like
                // every other "confirmed good" element in the app.
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 88px;
                        height: 88px;
                        border-radius: 44px;
                        background: #2dd8a326;
                        border-width: 2.5px;
                        border-color: #2dd8a3;
                        // Platform icon registry checkmark - the same
                        // exact-size pipeline as every crisp icon in the OS.
                        Icon {
                            name: "check";
                            size: IconSize.px48;
                            color: #2dd8a3;
                        }
                    }
                }

                Text {
                    text: "Transaction signed";
                    color: #ffffff;
                    font-size: 27px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Saved to the SD card. Nothing has been sent yet.";
                    color: #9aa0ab;
                    font-size: 15px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Rectangle {
                    border-radius: 14px;
                    background: #0d0d10;
                    border-width: 1px;
                    border-color: #1f2233;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 4px;
                        Text {
                            text: "FILE";
                            color: #2970ff;
                            font-size: 12px;
                            font-weight: 800;
                            letter-spacing: 1.5px;
                        }
                        Text {
                            text: SignTx.saved-path;
                            color: #ffffff;
                            font-size: 15px;
                            font-weight: 600;
                            wrap: char-wrap;
                        }
                    }
                }

                Text {
                    text: "Move the card to your online wallet and broadcast it there. This device stays offline.";
                    color: #9aa0ab;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // --- Error -------------------------------------------------------
            if SignTx.state == SignState.Error: TextMd {
                text: SignTx.error-text;
                color: Palette.content-tertiary;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        ButtonSection {
            // Idle: the two entry points.
            if SignTx.state == SignState.Idle: Button {
                label: TR2.lookup(TrId.SignScanQr);
                importance: Importance.primary;
                background: #2970ff;
                clicked => {
                    SignTx.start-qr-scan();
                }
            }
            if SignTx.state == SignState.Idle: Button {
                label: TR2.lookup(TrId.SignLoadSd);
                importance: Importance.secondary;
                clicked => {
                    SignTx.load-from-sd();
                }
            }
            if SignTx.state == SignState.Picking: Button {
                label: "Cancel";
                importance: Importance.secondary;
                clicked => {
                    SignTx.state = SignState.Idle;
                }
            }

            // Acknowledgment gate: when the companion lied about change, the
            // user MUST consciously acknowledge before Approve unlocks.
            if SignTx.state == SignState.Review && (SignTx.flagged-count > 0 || SignTx.fee-warning) && !SignTx.mismatch-acknowledged: Button {
                label: SignTx.flagged-count > 0 ? "I understand — these are NOT change" : "I understand — the fee is very high";
                importance: Importance.secondary;
                background: #5a1a1a;
                label-color: #ffd0d0;
                clicked => {
                    SignTx.mismatch-acknowledged = true;
                }
            }
            // Review: the consequential choice. Disabled while an unacknowledged
            // companion-mismatch is present, so it can't be signed reflexively.
            if SignTx.state == SignState.Review: Button {
                label: TR2.lookup(TrId.SignApprove);
                importance: Importance.primary;
                background: ((SignTx.flagged-count > 0 || SignTx.fee-warning) && !SignTx.mismatch-acknowledged) ? #1a2a44 : #2970ff;
                label-color: #ffffff;
                enabled: !((SignTx.flagged-count > 0 || SignTx.fee-warning) && !SignTx.mismatch-acknowledged);
                clicked => {
                    SignTx.approve();
                }
            }
            if SignTx.state == SignState.Review: Button {
                label: TR2.lookup(TrId.SignReject);
                importance: Importance.secondary;
                clicked => {
                    SignTx.reject();
                }
            }

            // Terminal states: one way out.
            if SignTx.state == SignState.ShowQr || SignTx.state == SignState.Done || SignTx.state == SignState.Error: Button {
                label: TR2.lookup(TrId.CommonDone);
                importance: Importance.primary;
                background: #2970ff;
                label-color: #ffffff;
                clicked => {
                    SignTx.reject();
                    Navigate.backward();
                }
            }

            // Scanning: let the user back out.
            if SignTx.state == SignState.Scanning: Button {
                label: TR2.lookup(TrId.CommonCancel);
                importance: Importance.secondary;
                clicked => {
                    SignTx.reject();
                }
            }
        }
    }
}
