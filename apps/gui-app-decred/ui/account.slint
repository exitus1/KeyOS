//
// Watch-only account export (create_account.rs). Exports the account dpub for
// Cake Wallet to import as a watch-only wallet.

export enum AccountState {
    Idle,
    Exported,
    Error,
}

// One row in the accounts picker list. `path` is pre-formatted in Rust
// because Slint cannot concatenate ints into strings.
export struct AccountRow {
    idx: int,
    name: string,
    path: string,
    active: bool,
    // First letter of the name, uppercased (Slint has no substring).
    initial: string,
    // Deterministic per-account accent color for the avatar circle.
    accent: color,
}

export global Account {
    in property <AccountState> state: AccountState.Idle;
    in property <string> account-dpub;
    // Display metadata for the export page: the exported account's name,
    // its derivation path, and head/tail of the dpub for verification.
    in property <string> export-name;
    in property <string> export-path;
    in property <string> dpub-head;
    in property <string> dpub-tail;
    in property <int> index;
    in property <string> error-text;

    // Derive m/44'/42'/index' and return its neutered dpub.
    callback export-account-xpub(int);
    // Write the account shown on the export page to the SD card (accounts.dcr).
    callback write-account-export();
    // Write every named account to the SD card in one file (one seed prompt).
    callback export-all-accounts();
    // Result note of the last SD write ("" = none yet / cleared on new export).
    in property <string> sd-note;
    // The currently-active account index the whole app operates on.
    in-out property <int> active-index: 0;
    // Set the active account (updates state.account so receive/sign/export use it).
    callback set-active-account(int);

    // --- accounts picker page ---
    // Named account list (from the on-device AccountStore).
    in property <[AccountRow]> rows;
    // Name of the active account, for display on other pages.
    in property <string> active-name;
    // Validation error from the last create attempt ("" = success).
    in-out property <string> name-error;
    // Create a named account at the next free index and make it active.
    callback create-account(string);
}
